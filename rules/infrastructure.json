{
    "debug_log_file": "debug-1371fd.log",
    "debug_session_id": "1371fd",
    "max_safe_run_recursion": 8,
    "ssh_max_sessions": 50,
    "ulimit_nofile": 65536,
    "fs_file_max": 2097152,
    "tcp_rmem_max": 134217728,
    "tcp_wmem_max": 134217728,
    "max_engagements_to_keep": 15,
    "min_disk_space_gb": 50,
    "global_dns_resolver": "1.1.1.1",
    "vps_results_base": "~/redteam-workspace/results",
    "disallowed_python_patterns": [
        "os.system",
        "subprocess.run",
        "shutil.rmtree",
        "os.remove",
        "os.chmod"
    ],
    "bash_dangerous_patterns": [
        "rm\\s+-rf\\s+/",
        ">\\s+/dev/sda",
        "mkfs",
        "dd\\s+if=",
        "chmod\\s+777\\s+/",
        "chown\\s+root"
    ],
    "allowed_command_wrappers": [
        "proxychains4",
        "torify",
        "sudo",
        "timeout",
        "sh",
        "bash",
        "python3"
    ],
    "tool_flag_sanitization": [
        {
            "match": "gobuster",
            "search": "\\s+--wildcard\\b",
            "replace": ""
        },
        {
            "match": "gobuster",
            "search": " -w ",
            "replace": " -w="
        },
        {
            "match": "gobuster",
            "search": "gobuster\\s+(?!(dir|dns|vhost|fuzz|s3|gcs|tftp|version|help))",
            "replace": "gobuster dir "
        },
        {
            "match": "nikto",
            "search": "--(useragent|host|port|output|Pause|pause|Format|Tuning|ssl|timeout|Display|evasion|id|config|dbcheck|nointeractive|nolookup|update|Version|ask|maxtime|noslash)\\b",
            "replace": "-\\1"
        },
        {
            "match": "sqlmap",
            "search": "--random_agent|-random-agent",
            "replace": ""
        },
        {
            "match": "sqlmap",
            "search": "--(level|risk)\\s+",
            "replace": "--\\1="
        },
        {
            "match": "nikto",
            "search": "\\s+-host\\s+",
            "replace": " -h "
        },
        {
            "match": "nikto",
            "search": "\\s+-p\\s+",
            "replace": " -port "
        },
        {
            "match": "sqlmap",
            "search": "--proxy[\\s=]\\S+",
            "replace": ""
        },
        {
            "match": "sqlmap",
            "search": "--batch --random-agent",
            "replace": "--batch --random-agent --level 3 --risk 2"
        },
        {
            "match": "wfuzz",
            "search": "--data\\s+",
            "replace": "-d "
        }
    ],
    "_comment_ip_rotation": "Tor/proxy identity rotation settings",
    "tor_socks_port": 9050,
    "tor_control_port": 9051,
    "ip_rotation_every_n_requests": 5,
    "ip_rotation_timeout_secs": 20,
    "ip_rotation_settle_secs": 2,
    "ip_rotation_verify_change": true,
    "ip_rotation_max_errors": 3,
