# Copy this file to .env and fill in real API keys. Do NOT commit .env to git.

# Which provider to lead with. Groq is PRIMARY; Gemini is the FALLBACK.
# (A FREE Gemini key rate-limits after a few calls and can't sustain a full run,
#  so it is the fallback, not the primary. Use a PAID Gemini key + AI_BACKEND=gemini
#  if you specifically want Gemini to lead.)
AI_BACKEND=groq

# GROQ: PRIMARY AI provider key(s). You can set a single key or comma-separated keys.
# Example: GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_API_KEY=
GROQ_API_KEYS=

# Optional: a default GROQ key used when no env keys are set (for local testing only).
# _DEFAULT_GROQ_KEY=

# Google Gemini: FALLBACK provider, used when the Groq pool is exhausted.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# OpenRouter (set a valid model id for your account)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama_model_name

# Proxy (optional)
PROXY_URL=

# Other: leave as-is unless you know what you're changing
# WSL Settings (replaces VPS settings)
USE_WSL=true
USE_REMOTE_VPS=true
# WSL_DISTRO=
# WSL_USER=
# WSL_TEMP_DIR=/tmp/antigravity
# WSL_RESULTS_DIR=/root/results

# VPS Settings (DEPRECATED)
# VPS_HOST=
# VPS_USER=
# VPS_KEY_PATH=
